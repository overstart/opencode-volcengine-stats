{
  "name": "opencode-volcengine-stats",
  "version": "1.0.0",
  "description": "OpenCode V2 CLI plugin: show Volcengine Ark Coding Plan quota (5h / weekly / monthly) as progress bars in the session sidebar.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2-plugin",
    "opencode-tui-plugin",
    "volcengine",
    "ark",
    "coding-plan",
    "usage",
    "quota",
    "tui"
  ],
  "license": "MIT",
  "author": "liyf",
  "type": "module",
  "homepage": "https://github.com/overstart/opencode-volcengine-stats#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overstart/opencode-volcengine-stats.git"
  },
  "bugs": {
    "url": "https://github.com/overstart/opencode-volcengine-stats/issues"
  },
  "exports": {
    "./tui": {
      "import": "./tui.tsx"
    }
  },
  "files": [
    "tui.tsx",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=2.0.0"
  },
  "scripts": {
    "check": "bun run src/usage.ts --check",
    "check:tui": "bun run check-tui.tsx",
    "fetch": "bun run src/usage.ts",
    "typecheck": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.32"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "@types/bun": "latest",
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2"
  }
}
